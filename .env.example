# Safe, non-secret defaults. Copy to .env (git-ignored) and fill in.
SIGI_PORT=3220
SIGI_DATA_DIR=./data
SIGI_LOG_LEVEL=info

# The origin browsers use when deployed, e.g. https://sigi.example.id.
# Leave empty for local development on http://127.0.0.1:3220.
SIGI_PUBLIC_ORIGIN=

# The worker: hours between checks of the exchange's ownership-data page, and
# the Chrome it drives. On macOS:
#   SIGI_CHROME_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
SIGI_FETCH_INTERVAL_HOURS=24
SIGI_CHROME_PATH=/usr/bin/google-chrome
