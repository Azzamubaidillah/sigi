# Safe, non-secret defaults. Copy to .env (git-ignored) and fill in.
SIGI_PORT=3220
SIGI_DATA_DIR=./data
SIGI_LOG_LEVEL=info

# The origin browsers use when deployed, e.g. https://sigi.example.id.
# Leave empty for local development on http://127.0.0.1:3220.
SIGI_PUBLIC_ORIGIN=
# "true" only behind a reverse proxy that appends X-Forwarded-For.
SIGI_TRUSTED_PROXY=false

# Owner sign-in for /admin. Generate the hash with `pnpm passcode:hash` and a
# secret with `openssl rand -base64 48`. Without both, nobody can sign in.
SIGI_PASSCODE_HASH=
SIGI_SESSION_SECRET=
